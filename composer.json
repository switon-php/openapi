{
    "name": "switon/openapi",
    "description": "Split OpenAPI YAML workflow with route sync, merged export, and spec quality lint for Switon Framework",
    "type": "library",
    "keywords": [
        "switon",
        "openapi",
        "swagger",
        "api"
    ],
    "homepage": "https://github.com/switon-php/openapi",
    "license": "MIT",
    "authors": [
        {
            "name": "switon",
            "email": "admin@switon.dev"
        }
    ],
    "support": {
        "source": "https://github.com/switon-php/openapi",
        "issues": "https://github.com/switon-php/openapi/issues",
        "docs": "https://docs.switon.dev/latest/openapi"
    },
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "switon/command": "^1.0",
        "switon/core": "^1.0",
        "switon/http": "^1.0",
        "switon/router": "^1.0",
        "switon/yaml": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "switon/testing": "^1.0",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "switon/composer-extra": true,
            "phpstan/extension-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "Switon\\OpenApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Switon\\OpenApi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "@php vendor/bin/phpstan analyse",
        "test:unit": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=unit --display-deprecations --display-phpunit-notices",
        "test": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=all --display-deprecations --display-phpunit-notices"
    },
    "extra": {
        "switon": {
            "providers": [
                "Switon\\OpenApi\\ServiceProvider"
            ],
            "commands": [
                "Switon\\OpenApi\\Command\\OpenApiCommand"
            ]
        },
        "branch-alias": {
            "dev-dev": "1.0.x-dev"
        }
    }
}
